{% set kargoUcretsiz = ucretsizKargoLimitleri('ucretsiz_kargo') %}
{% set kargoKalanGoster = ucretsizKargoLimitleri('kalan_tutar_goster') %}
{% if kargoUcretsiz or kargoKalanGoster %}
<div class="kargo-kampanya-sepet-pc">
    <div class="kampanya-kutu">
        <h3 class="kampanya-baslik">
            Kargo Kampanyası 
            <img src="{{ temaDosyalari('/assets/images/hizli-kargo-pc.webp') }}" alt="Kargo Kampanyası" class="kampanya-img">
        </h3> 
        <p class="kampanya-aciklama">
            <span class="magaza-adi">Tilbe Home</span> Mağazamızdan 
            {% if not kargoUcretsiz %}
                <span class="eksik-tutar">{{ ucretsizKargoLimitleri('kalan_tutar') }}</span>'lik ürün daha ekleyin, ürünleriniz için kargo ücreti ödemeyin!
            {% else %}
                <span class="tebrikler">Tebrikler! Ücretsiz Kargo Avantajını Kazandınız!</span>
            {% endif %}
        </p>
    </div>
</div>
{% endif %}
