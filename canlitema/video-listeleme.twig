<!-- Video Modal -->
<div class="tilbe-bv04kf-modal" id="videoModal">
    <div class="tilbe-bv04kf-modal-content">
        <span class="tilbe-bv04kf-close-modal" onclick="closeModal()">&times;</span>
        <iframe id="videoIframe" width="100%" height="100%" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    </div>
</div>

<!-- Swiper ve Scriptler -->
<script>
(function () {
    if (!window.customElements) return;
    const source = 'https://cdn.jsdelivr.net/npm/swiper@10/swiper-element-bundle.min.js';
    if (!customElements.get('swiper-container') &&
        !Array.from(document.scripts).some(script => script.src === source)) {
        const loader = document.createElement('script');
        loader.src = source;
        loader.async = true;
        document.head.appendChild(loader);
    }
    customElements.whenDefined('swiper-container').then(function () {
        document.querySelectorAll('.tilbe-bv04kf-categoray swiper-container').forEach(function (element) {
            if (!element.isConnected || element.initialized) return;
            Object.assign(element, {
                spaceBetween: 20,
                loop: true,
                autoplay: { delay: 3000 },
                breakpoints: {
                    320: { slidesPerView: 2 },
                    768: { slidesPerView: 2 },
                    1024: { slidesPerView: 6 }
                }
            });
            element.initialize();
        });
    });
})();
</script>

<script>
    // Video açma fonksiyonu
    function openModal(videoUrl) {
        const iframe = document.getElementById('videoIframe');
        iframe.src = videoUrl; // Video URL'sini iframe'e ekliyoruz
        document.getElementById('videoModal').style.display = 'block'; // Modal'ı açıyoruz
    }

    // Modal'ı kapama fonksiyonu
    function closeModal() {
        const iframe = document.getElementById('videoIframe');
        iframe.src = ''; // iframe kaynağını temizliyoruz
        document.getElementById('videoModal').style.display = 'none'; // Modal'ı kapatıyoruz
    }
</script>