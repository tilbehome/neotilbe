<!-- Swiper ve Scriptler -->
<script>
(function () {
    if (!window.customElements) return;
    const source = 'https://cdn.jsdelivr.net/npm/swiper@10/swiper-element-bundle.min.js';
    if (!customElements.get('swiper-container') &&
        !Array.from(document.scripts).some(script => script.src === source)) {
        const loader = document.createElement('script');
        loader.src = source;
        loader.async = true;
        document.head.appendChild(loader);
    }
    customElements.whenDefined('swiper-container').then(function () {
        document.querySelectorAll('.tilbe-bv04kf-categoray swiper-container').forEach(function (element) {
            if (!element.isConnected || element.initialized) return;
            Object.assign(element, {
                spaceBetween: 20,
                loop: true,
                autoplay: { delay: 3000 },
                breakpoints: {
                    320: { slidesPerView: 2 },
                    768: { slidesPerView: 2 },
                    1024: { slidesPerView: 6 }
                }
            });
            element.initialize();
        });
    });
})();
</script>

