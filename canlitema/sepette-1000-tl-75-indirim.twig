{# Discount eligibility and amounts are computed by the platform. #}
<div class="kampanya-container">
    <div class="kampanya-baslik">Sepet İndirimleri</div>
    <div class="kampanya-mesaji">
        <i class="fa fa-gift" aria-hidden="true"></i>
        <span class="kampanya-mesaji-rengi8">
            {% if sepetBilgileri('ozet').indirim_var_mi %}
                Sepetinize uygulanan indirimi sipariş özetinde görebilirsiniz.
            {% else %}
                İndirim tutarı, geçerli kampanya koşullarına göre sipariş özetinde gösterilir.
            {% endif %}
        </span>
    </div>
</div>
