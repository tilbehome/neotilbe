<section class="menu">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="mega-menu side">
                    <ul class="navbar-nav">
                        {% for kategori in tumKategoriler(0, temaAyarlari('genel', 'ust_menu_limit')) %}
                            <li class="nav-item {% if kategori.alt_kategori_var_mi == true %}dropdown{% endif %}"> 
                            {% include 'moduller/diger/kategori_icon.twig' %}
                                <a class="nav-link dropdown-toggle" href="{{ kategori.link }}" id="mega-menu-{{ kategori.ID }}" data-parent-id="{{ kategori.ID }}" role="button">
                                    <span class="under-category">{{ buyukCevir(kategori.adi) }}</span>
                                </a>
                                 {% if kategori.alt_kategori_var_mi == true %}
                                    <div class="dropdown-menu" aria-labelledby="mega-menu-{{ kategori.ID }}">
                                            <div class="mega-menu-container">
                                                <div class="container-fluid" >
                                                    <div class="row">
                                                        <div class="col-md-12">
                                                            <div class="row h-100">
                                                        
                                                            {% for liste_index, alt_kategoriler in listeyiBol(kategori.alt_kategoriler, 3)  %}
                                                                <div class="col">
                                                                    {% for alt_kategori_1 in alt_kategoriler %}
                                                                        <div class="sub-cat">
                                                                            <a class="sub-title" data-parent-id="{{ kategori.ID }}" data-id="{{ alt_kategori_1.ID }}" href="{{ alt_kategori_1.link }}">
                                                                               {{ cevir(alt_kategori_1.adi) }}
                                                                            </a>
                                                                            <ul>
                                                                                {% if alt_kategori_1.alt_kategori_var_mi == true  and temaAyarlari('header_area','alt_kategori_seviye') %}
                                                                                    {% for index, alt_kategori_2 in alt_kategori_1.alt_kategoriler %}
                                                                                        <li>
                                                                                            <a href="{{ alt_kategori_2.link }}">
                                                                                                <span class="sub-category">{{ alt_kategori_2.adi }}</span>
                                                                                                <span class="comma">,</span>
                                                                                            </a>
                                                                                            {{ (index + 1) < alt_kategori_1.alt_kategoriler|length ? '': '' | raw }}
                                                                                        </li>
                                                                                    {% endfor %}
                                                                                {% endif %}
                                                                            </ul>
                                                                        </div>
                                                                    {% endfor %}
                                                                </div>
                                                            {% endfor %}
        
                                                             </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                    </div>   
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                 </div>
            </div>
        
        </div>
    </div>
</section>