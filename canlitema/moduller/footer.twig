<script>
(function () {
  function initializeCategoryMenu() {
    const wrapper = document.getElementById('tilbehomeMobilMenu456-kategori-btn');
    const trigger = wrapper && wrapper.querySelector('a');
    const container = document.querySelector('.thkm456-container');
    if (!trigger || !container || container.dataset.tilbeInitialized) return;
    const panel = container.querySelector('.thkm456-menu');
    const close = container.querySelector('.thkm456-close');
    const backdrop = container.querySelector('.thkm456-backdrop');
    if (!panel || !close || !backdrop) return;
    container.dataset.tilbeInitialized = 'true';
    const otherModalOpen = () => Boolean(document.querySelector('.modal.show'));
    function closeMenu() {
      if (!container.classList.contains('active')) return;
      container.classList.remove('active');
      container.setAttribute('aria-hidden', 'true');
      trigger.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('tilbe-category-open');
      if (!otherModalOpen()) trigger.focus();
    }
    trigger.addEventListener('click', function (event) {
      event.preventDefault();
      container.classList.add('active');
      container.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      document.body.classList.add('tilbe-category-open');
      close.focus();
    });
    close.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);
    document.addEventListener('keydown', function (event) {
      if (!container.classList.contains('active') || otherModalOpen()) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
      } else if (event.key === 'Tab') {
        const items = Array.from(panel.querySelectorAll('a[href], button:not([disabled]), [tabindex="0"]'))
          .filter(item => item.getClientRects().length);
        if (!items.length) { event.preventDefault(); panel.focus(); return; }
        const first = items[0], last = items[items.length - 1];
        if (event.shiftKey && (document.activeElement === first || !panel.contains(document.activeElement))) {
          event.preventDefault(); last.focus();
        } else if (!event.shiftKey && (document.activeElement === last || !panel.contains(document.activeElement))) {
          event.preventDefault(); first.focus();
        }
      }
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeCategoryMenu, { once: true });
  else initializeCategoryMenu();
})();
</script>
    
