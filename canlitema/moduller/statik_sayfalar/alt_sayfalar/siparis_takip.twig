<!-- 🧾 Sipariş Takip Sayfası (Microdata ile) -->
<div class="order-detail-wrapper">

  <h1>Sipariş Sorgulama 🚀</h1>
  <h2>Sipariş durumunuzu anında öğrenin</h2>

  <div class="explanation">
    <span>
      Sipariş numaranızı ve e-posta adresinizi girerek sipariş detaylarınıza kolayca ulaşabilirsiniz.
    </span>
  </div>

  <form class="order-detail-form" action="" method="post"
        onsubmit="return orderDetailForm(this, '.order-detail-response')">

    <label for="orderTrackEmail">E-posta Adresi <span class="text-danger">*</span></label>
    <input type="text" class="form-control m-input" id="orderTrackEmail" name="email" value="">
    <div class="mt-3"></div>

    <label for="orderTrackNumber">Sipariş Numarası <span class="text-danger">*</span></label>
    <input type="text" class="form-control m-input" id="orderTrackNumber" name="order_no" value="">
    <div class="mt-3"></div>  

    <button type="submit" class="btn btn-success">
      Sipariş Sorgula
    </button>
  </form>  

  <div class="order-detail-response mt-3"></div>

  <!-- 🏢 Marka Bilgisi -->
  <div>
  </div>
</div>