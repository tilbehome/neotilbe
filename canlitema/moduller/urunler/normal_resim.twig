<div class="product-profile-1" data-product-id="{{ sayfaBilgileri('ID') }}">
    <div id="product-profile-carousel" class="slide product-carousel-desktop normal" >
        <div class="carousel-outer">
            <div class="carousel-inner">
                
               <div class="row">
                       
                {% for index, resim in sayfaBilgileri('resimler') %}
                       <div class="col-md-12 mb-3">
                            <div class="carousel-item active">
                                <a href="{{ resim.buyuk }}" class="primary-product-img" data-fancybox="images" data-caption="{{ sayfaBilgileri('adi_alt') }}">
                                    <img src="{{ resim.normal }}" alt="{{ sayfaBilgileri('adi_alt') }}">
                                </a>
                            </div>
                       </div>
                {% endfor %}
                
               </div>
            </div>
        </div>
    </div>
    <div id="product-profile-carousel-{{ sayfaBilgileri('ID') }}" class="carousel slide product-carousel-mobile" data-ride="carousel">
        <div class="row">
            <div class="col-md-5">
                <ol class="carousel-indicators">
                    {% for index, resim in sayfaBilgileri('resimler') %}
                        <li data-target="#product-profile-carousel-{{ sayfaBilgileri('ID') }}" 
                            data-slide-to="{{ index }}" class="{{ index == 0 ? 'active' : '' }}">
                            <img class="d-block w-100" src="{{ resim.thumb }}" alt="{{ sayfaBilgileri('adi_alt') }}" data-zoom-image="{{ resim.buyuk }}">
                        </li>
                    {% endfor %}
                </ol>                   
            </div>
        
            <div class="col-md-12 pl-0 pr-0">
                <div class="carousel-outer">
                    <div class="carousel-inner">
                        {% for index, resim in sayfaBilgileri('resimler') %}
                            <div class="carousel-item {{ index == 0 ? 'active' : '' }}">
                                <a href="{{ resim.buyuk }}" data-fancybox="images" data-caption="{{ sayfaBilgileri('adi_alt') }}">
                                    <img  src="{{ resim.normal }}" alt="{{ sayfaBilgileri('adi_alt') }}" >
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                    {% if sayfaBilgileri('resimler')|length > 1 %}
                        <a class="carousel-control-prev" href="#product-profile-carousel-{{ sayfaBilgileri('ID') }}" role="button" data-slide="prev">
                            <i class="fa fa-chevron-left"></i>
                        </a>
                        <a class="carousel-control-next" href="#product-profile-carousel-{{ sayfaBilgileri('ID') }}" role="button" data-slide="next">
                            <i class="fa fa-chevron-right"></i>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>  
</div>