{% block modulFooterKodlari %}

<script src="{{ temaDosyalari('/assets/product-video-popup.js') }}" defer></script>

<script>
(function () {
  document.querySelectorAll('.campaignTimerDiv').forEach(function (root) {
    if (root.dataset.shipmentTimerReady) return;
    const title = root.querySelector('.count-end-block .title');
    const parts = {};
    for (const key of ['day', 'hour', 'min', 'sec']) {
      parts[key] = root.querySelector('[data-shipment-part="' + key + '"] span');
      if (!parts[key]) return;
    }
    if (!title) return;
    root.dataset.shipmentTimerReady = 'true';

function getTurkeyTime() {
  return new Date(new Date().toLocaleString("en-US", { timeZone: "Europe/Istanbul" }));
}

function updateCountdown() {
  if (!root.isConnected) return;
  const now = getTurkeyTime();
  const day = now.getDay(); // 0: Pazar, 1: Pazartesi ... 6: Cumartesi
  const hours = now.getHours();

  let targetDate;
  let titleText;

  // Hafta içi 00:00 - 12:00
  if (day >= 1 && day <= 5 && hours < 12) {
    targetDate = new Date(now);
    targetDate.setHours(12, 0, 0, 0);
    titleText = "Şimdi sipariş verirsen, <b>BUGÜN</b> kargoda";
  }
  // Pazartesi - Perşembe 12:00 sonrası
  else if (day >= 1 && day <= 4 && hours >= 12) {
    targetDate = new Date(now);
    targetDate.setDate(now.getDate() + 1);
    targetDate.setHours(12, 0, 0, 0);
    titleText = "Şimdi sipariş verirsen, <b>YARIN</b> kargoda";
  }
  // Cuma 12:00 sonrası → Cumartesi kargoda
  else if (day === 5 && hours >= 12) {
    targetDate = new Date(now);
    targetDate.setDate(now.getDate() + 1); // Cumartesi
    targetDate.setHours(12, 0, 0, 0);
    titleText = "Şimdi sipariş verirsen, <b>CUMARTESİ</b> kargoda";
  }
  // Cumartesi 00:00 - 12:00
  else if (day === 6 && hours < 12) {
    targetDate = new Date(now);
    targetDate.setHours(12, 0, 0, 0);
    titleText = "Şimdi sipariş verirsen, <b>BUGÜN</b> kargoda";
  }
  // Cumartesi 12:00 sonrası veya Pazar
  else {
    targetDate = new Date(now);
    targetDate.setDate(now.getDate() + (day === 6 ? 2 : 1)); // Cumartesi akşam → Pazartesi, Pazar → Pazartesi
    targetDate.setHours(12, 0, 0, 0);
    titleText = "Şimdi sipariş verirsen, <b>PAZARTESİ</b> kargoda";
  }

  // Geri sayım
  const timeDiff = targetDate - now;
  const daysLeft = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
  const hoursLeft = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
  const minutesLeft = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
  const secondsLeft = Math.floor((timeDiff % (1000 * 60)) / 1000);

  title.innerHTML = titleText;
  parts.day.textContent = String(daysLeft).padStart(2, "0");
  parts.hour.textContent = String(hoursLeft).padStart(2, "0");
  parts.min.textContent = String(minutesLeft).padStart(2, "0");
  parts.sec.textContent = String(secondsLeft).padStart(2, "0");

  setTimeout(updateCountdown, 1000);
}

updateCountdown();

  });
})();
</script>



