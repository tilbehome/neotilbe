{% extends varsayilanBlokModul() %}

{% block modulBaslik %}
    {{ sayfaBilgileri('adi') }}
{% endblock %} 

{% block modulIcerik %}

    {% if sayfaBilgileri('gosterim') == 1 %}

        {% if sayfaBilgileri('kategoriler').sayi > 0 %}
            <div class="category-pg-inner">
                
                <div class="row">
                    {% for kategori in sayfaBilgileri('kategoriler').liste %}
                        <div class="{{ modul.listeleme_class }} col-list-p-v-1">
                            {% include modul.kategori_kart %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="category-pg-inner">
                <div class="alert alert-warning">
                    {{ cevir('kategori_bulunamadi') }}
                </div>
            </div>
        {% endif %}

    {% else %}
    

        <div class="d-none d-lg-block">
            <div class="category-filter-order">
                <div class="list-wrap">
                    <div class="payment-page-title-block">
    <h4 class="d12fg154dfg">Ürün Filtreleme</h4>
    <!-- Filtreleme ile ilgili bir ikon, örneğin filtre ikonu -->
    <i class="fas fa-filter"></i> <!-- Filter Ikonu -->
</div>
<p class="tilbe-sub">Ürünlerinizi çeşitli kriterlere göre filtreleyin.</p>
<hr>
                    <ul class="list">
                        {% for siralama in sayfaBilgileri('siralama_tipleri') %}
                            <li>
                                <div class="lag-checkbox {{ siralama.ID == 'akilli-siralama' ? 'siralama99' : '' }}">
                                    <input id="cat-filter-order-{{ siralama.ID }}" name="smart-cat-siralama" value="{{ siralama.ID }}" data-search-value="{{ siralama.ID }}" data-smart-cat-search="1" type="radio" {{ siralama.secili ? 'checked' : '' }}>
                                    <label for="cat-filter-order-{{ siralama.ID }}">{{ siralama.baslik }}</label>
                                    <span></span>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        {% include 'moduller/kategoriler/responsive_butonlar.twig'  %}

        {% if sayfaBilgileri('icerik').icerik_sayisi > 0 %}
            <div class="row">
                {% for urun in sayfaBilgileri('icerik').liste %}
                    <div class="{{ modul.listeleme_class }} col-list-p-v-1">
                        {% include modul.kart %}
                    </div>
                {% endfor %}
            </div>

            <div class="pagination-wrapper">
                {% include modul.sayfalar  %}
            </div>
        {% else %}
            <div class="p-2">
                <div class="alert alert-warning">
                    {{ cevir('urun_bulunamadi') }}
                </div>
            </div> 
        {% endif %}
    {% endif %}
{% endblock %} 

{% block modulFooterKodlari %}
   <script type="text/javascript">
    var CATEGORY_PAGE_DATA = {
        k: '{{ sayfaBilgileri('aranan')|e('js') }}',
        url: '{{ sayfaBilgileri('ana_link')|e('js') }}',
        filtreleme: '{{ sayfaBilgileri('filtreleme_anahtari')|e('js') }}',
    };

    $(function(){
        smartCategoryFilters(CATEGORY_PAGE_DATA);
        setResponsiveCategoryView(); // Sayfa yüklendiğinde çağır
        $(window).off('resize.tilbeCategory').on('resize.tilbeCategory', setResponsiveCategoryView); // Pencere boyutu değiştiğinde çağır
    });

    function setResponsiveCategoryView() {
        const screenWidth = $(window).width();

        let cls = 'col-6'; // Varsayılan: 2 sütun (mobil cihazlar için)

        if (screenWidth >= 1200) {
            cls = 'col-xl-custom-5'; // 5 sütun (1200px ve üzeri)
        } else if (screenWidth >= 992) {
            cls = 'col-lg-3'; // 4 sütun (992px ve üzeri)
        } else if (screenWidth >= 768) {
            cls = 'col-md-6'; // 2 sütun (768px ve üzeri)
        } else if (screenWidth >= 576) {
            cls = 'col-sm-6'; // 2 sütun (576px ve üzeri)
        }

        $(".p-g-mod-t-20 .col-list-p-v-1").removeClass(function (_, classes) {
            return classes.split(/\s+/).filter(name => /^col-(?:(?:sm|md|lg|xl)-)?\d+$/.test(name) || name === "col-xl-custom-5").join(" ");
        })
            .addClass(`col-6 col-sm-6 col-md-6 col-lg-3 ${cls} col-list-p-v-1`);

        // Automatic layout does not overwrite stored platform view preferences.
    }

    $(".product-view-select").hide(); // Görünüm butonlarını gizle
</script>

{% endblock %}