<div class="cstm-manset-block">
    <div class="countdown">
        <div class="countdown-item"><div data-countdown-part="days">0</div><span>Gün</span></div>
        <div class="countdown-item"><div data-countdown-part="hours">00</div><span>Saat</span></div>
        <div class="countdown-item"><div data-countdown-part="minutes">00</div><span>Dakika</span></div>
        <div class="countdown-item"><div data-countdown-part="seconds">00</div><span>Saniye</span></div>
    </div>
    <div class="cmanset-write">
        <h1>Alışverişte Çifte Kazanç Fırsatı!</h1>
        <span>Sepetine 3 Farklı Ürün At, Veya Çok Al Çok Kazan!</span>
        <a href="/tumu-c-0?siralama=cok-satanlar">Tüm Ürünleri Göster</a>
    </div>
    <div class="cmanset-bg">
        <img src="{{ temaDosyalari('/cmanset-discount.svg') }}" alt="manşet flaş indirim icon">
    </div>
</div>

<script>
(function () {
  const root = document.currentScript && document.currentScript.previousElementSibling;
  if (!root) return;
function initialize() {

    // İki basamaklı sayı gösterimi için yardımcı fonksiyon
    function padNumber(number) {
        return number.toString().padStart(2, '0');
    }

    // Gelecek Pazartesi saat 23:59:59'u hesaplar
    function getNextMonday() {
        const now = new Date();
        const dayOfWeek = now.getDay(); // 0: Pazar, 1: Pazartesi
        const daysUntilMonday = (1 - dayOfWeek + 7) % 7;

        const targetDate = new Date(now);
        targetDate.setDate(now.getDate() + daysUntilMonday);
        targetDate.setHours(23, 59, 59, 999);

        return targetDate.getTime();
    }

    // Geri sayım değerlerini günceller
    function updateCountdown() {
        const now = new Date().getTime();
        const remainingTime = Math.max(targetTime - now, 0);

        const days = Math.floor(remainingTime / (1000 * 60 * 60 * 24));
        const hours = Math.floor((remainingTime % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((remainingTime % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((remainingTime % (1000 * 60)) / 1000);

        root.querySelector('[data-countdown-part="days"]').textContent = days;
        root.querySelector('[data-countdown-part="hours"]').textContent = padNumber(hours);
        root.querySelector('[data-countdown-part="minutes"]').textContent = padNumber(minutes);
        root.querySelector('[data-countdown-part="seconds"]').textContent = padNumber(seconds);

        // Geri sayım bittiğinde yeni hedef zamanı ayarla
        if (remainingTime <= 0) {
            targetTime = getNextMonday();
        }
    }

    let targetTime = getNextMonday();
    updateCountdown();
    const timer = setInterval(function () {
      if (!root.isConnected) { clearInterval(timer); return; }
      updateCountdown();
    }, 1000);
}
if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initialize, { once: true });
else initialize();
})();
</script>