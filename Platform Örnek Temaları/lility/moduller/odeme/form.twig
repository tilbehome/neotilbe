    {% include 'moduller/odeme/bilgiler/kargo.twig' %}{% include siparisTeslimatZamanlari() %} 

    {% if kullaniciGirisYaptiMi() and temaAyarlari('genel','kargo_fisi') %}
        {% if kullaniciBilgileri('bayi_durumu') %} 
            {% include 'moduller/odeme/bilgiler/kargo_sablonu.twig' %} 
        {% endif %}
    {% endif %}
    
    {% if ayarlar('siparis_notu') or ayarlar('hediye_paketi_kullanimi') %}
