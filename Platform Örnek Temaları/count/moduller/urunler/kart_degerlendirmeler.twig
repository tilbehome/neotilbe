<div class="product-reviews">
    <div class="stars">
        {% for degerlendirme in urun.degerlendirme.liste %}
            <span class="star {{ degerlendirme.aktif ? 'fill' : '' }}">
                {% if degerlendirme.tip == 'half' %}
                    <i class="fa fa-star-half"></i>
                    <i class="fa fa-star dark"></i>
                {% else %}
                    <i class="fa fa-star"></i>
                {% endif %}
            </span>
        {% endfor %}
    </div>
    {% if urun.degerlendirme.oy_sayisi > 0 %}
        <span class="count">({{ urun.degerlendirme.oy_sayisi }})</span>
    {% endif %}
</div>