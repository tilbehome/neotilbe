{% extends varsayilanBlokModul() %}

{% block modulBaslik %}
    <i class="fas fa-box"></i>
    {{ cevir('odeme_siparis_bilgileri') }}
{% endblock %}


{% block modulIcerik %}
    <form class="payment-form-group-1" data-payment-box-form="order-info">

        {% if ayarlar('hediye_paketi_kullanimi') %}
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">

                        <label>
                            {{ cevir('hediye_paketi') }}
                            {% if ayarlar('hediye_paketi_ucreti') > 0 %}
                                <span class="gift-pack-price">(+{{ hediyePaketiUcreti() }})</span>
                            {% endif %}
                        </label>
                        <div class="clearfix"></div>

                        <input type="checkbox" name="gift_pack" id="orderInputGift" 
                        {{ siparisBilgileri('gift_pack') ? 'checked' : '' }}
                        value="1" > 
                        <label for="orderInputGift" class="ml-2">
                            {{ cevir('hediye_paketi_aciklama') }}
                        </label>

                    </div>
                </div>
            </div>
        {% endif %}

        {% if ayarlar('siparis_notu') %}
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label for="orderInputNotes"> 
                            {{ cevir('siparis_notu') }}
                            {% if ayarlar('siparis_notu_aciklama') is not empty %}
                                ({{ ayarlar('siparis_notu_aciklama') }})
                            {% endif %}
                        </label>
                        <textarea name="notes" class="form-control" id="orderInputNotes">{{ siparisBilgileri('notes') }}</textarea>
                    </div>
                </div>
            </div>
        {% endif %}

    </form>

{% endblock %}